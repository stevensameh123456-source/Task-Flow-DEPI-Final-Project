@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="light">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>TaskFlow | Create Account</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <!-- Register CSS -->
    <link rel="stylesheet"
          href="~/css/register.css"
          asp-append-version="true" />

    <!-- Saved Theme -->
    <script>
        try {
            const savedTheme = localStorage.getItem('tf-theme');

            document.documentElement.setAttribute(
                'data-bs-theme',
                savedTheme === 'dark' ? 'dark' : 'light'
            );
        } catch (e) { }
    </script>

</head>

<body class="tf-auth-page">

    <!-- Background -->
    <div class="tf-background">
        <span class="tf-blob tf-blob-1"></span>
        <span class="tf-blob tf-blob-2"></span>
        <span class="tf-blob tf-blob-3"></span>
        <div class="tf-grid"></div>
    </div>

    <!-- Theme Toggle -->
    <button class="tf-theme-btn"
            id="themeToggle"
            type="button"
            aria-label="Switch to dark mode"
            title="Toggle theme">

        <i class="fa-solid fa-sun sun-icon"></i>
        <i class="fa-solid fa-moon moon-icon"></i>

    </button>

    <!-- Main -->
    <main class="tf-auth-wrapper">

        <section class="tf-auth-card">

            <!-- Header -->
            <div class="tf-auth-header text-center">

                <div class="tf-logo">
                    <i class="fa-solid fa-check-double"></i>
                </div>

                <h1 class="tf-brand">
                    Task<span>Flow</span>
                </h1>

                <h2>Create Your Account</h2>

                <p>
                    Start organizing your work and boost your productivity.
                </p>

            </div>

            <!-- Server Error -->
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger tf-server-error" role="alert">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span>@ViewBag.Error</span>
                </div>
            }

            <!-- Registration Form -->
            <form asp-action="Register"
                  method="post"
                  id="registerForm"
                  novalidate>

                @Html.AntiForgeryToken()

                <!-- Full Name -->
                <div class="tf-form-group">

                    <label for="FullName">Full Name</label>

                    <div class="tf-input-wrapper">

                        <i class="fa-regular fa-user input-icon"></i>

                        <input type="text"
                               id="FullName"
                               name="FullName"
                               class="form-control"
                               placeholder="Enter your full name"
                               autocomplete="name"
                               required
                               autofocus />

                    </div>

                    <div class="tf-error" data-for="FullName"></div>

                </div>

                <!-- Email -->
                <div class="tf-form-group">

                    <label for="Email">Email Address</label>

                    <div class="tf-input-wrapper">

                        <i class="fa-regular fa-envelope input-icon"></i>

                        <input type="email"
                               id="Email"
                               name="Email"
                               class="form-control"
                               placeholder="name@example.com"
                               autocomplete="email"
                               required />

                    </div>

                    <div class="tf-error" data-for="Email"></div>

                </div>

                <!-- Password -->
                <div class="tf-form-group">

                    <label for="Password">Password</label>

                    <div class="tf-input-wrapper">

                        <i class="fa-solid fa-lock input-icon"></i>

                        <input type="password"
                               id="Password"
                               name="Password"
                               class="form-control"
                               placeholder="Create a strong password"
                               autocomplete="new-password"
                               required />

                        <button type="button"
                                class="tf-eye"
                                data-password="Password"
                                aria-label="Show password">

                            <i class="fa-regular fa-eye"></i>

                        </button>

                    </div>

                    <div class="tf-error" data-for="Password"></div>

                    <!-- Password Strength -->
                    <div class="tf-password-strength">

                        <div class="tf-strength-track">
                            <span id="strengthBar"></span>
                        </div>

                        <small id="strengthText">
                            Use at least 8 characters.
                        </small>

                    </div>

                </div>

                <!-- Confirm Password -->
                <div class="tf-form-group">

                    <label for="ConfirmPassword">Confirm Password</label>

                    <div class="tf-input-wrapper">

                        <i class="fa-solid fa-shield-halved input-icon"></i>

                        <input type="password"
                               id="ConfirmPassword"
                               name="ConfirmPassword"
                               class="form-control"
                               placeholder="Confirm your password"
                               autocomplete="new-password"
                               required />

                        <button type="button"
                                class="tf-eye"
                                data-password="ConfirmPassword"
                                aria-label="Show password">

                            <i class="fa-regular fa-eye"></i>

                        </button>

                    </div>

                    <div class="tf-error" data-for="ConfirmPassword"></div>

                </div>

                <!-- Terms -->
                <div class="tf-terms">

                    <label class="tf-remember">

                        <input type="checkbox"
                               id="AgreeTerms"
                               name="AgreeTerms"
                               value="true"
                               required />

                        <span class="tf-custom-checkbox">
                            <i class="fa-solid fa-check"></i>
                        </span>

                        <span>
                            I agree to the
                            <a href="#" class="tf-terms-link">Terms</a>
                            and
                            <a href="#" class="tf-terms-link">Privacy Policy</a>.
                        </span>

                    </label>

                    <div class="tf-error" data-for="AgreeTerms"></div>

                </div>

                <!-- Submit -->
                <button type="submit"
                        class="tf-submit-btn"
                        id="registerBtn">

                    <span class="btn-text">
                        Create Account
                        <i class="fa-solid fa-arrow-right"></i>
                    </span>

                    <span class="btn-loading d-none">
                        <span class="spinner-border spinner-border-sm"></span>
                        Creating account...
                    </span>

                </button>

            </form>

            <!-- Login Link -->
            <div class="tf-register">

                <span>Already have an account?</span>

                <a href="/Account/Login">
                    Sign in
                </a>

            </div>

            <!-- Footer -->
            <div class="tf-auth-footer">
                © 2026 TaskFlow. All rights reserved.
            </div>

        </section>

    </main>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Register JS -->
    <script src="~/js/register.js" asp-append-version="true"></script>

</body>
</html>
