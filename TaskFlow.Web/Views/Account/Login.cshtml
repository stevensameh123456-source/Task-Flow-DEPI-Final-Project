@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>TaskFlow | Login</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/Login.css" asp-append-version="true" />

    <!-- Apply Saved Theme -->
    <script>
        try {
            const savedTheme = localStorage.getItem('tf-theme');
            document.documentElement.setAttribute(
                'data-bs-theme',
                savedTheme === 'dark' ? 'dark' : 'light'
            );
        } catch (e) { }
    </script>
</head>

<body class="tf-auth-page">

    <!-- Background -->
    <div class="tf-background">
        <span class="tf-blob tf-blob-1"></span>
        <span class="tf-blob tf-blob-2"></span>
        <span class="tf-blob tf-blob-3"></span>
        <div class="tf-grid"></div>
    </div>

    <!-- Theme Toggle -->
    <button class="tf-theme-btn"
            id="themeToggle"
            type="button"
            aria-label="Switch to dark mode"
            title="Toggle theme">

        <i class="fa-solid fa-sun sun-icon"></i>
        <i class="fa-solid fa-moon moon-icon"></i>
    </button>

    <!-- Main Content -->
    <main class="tf-auth-wrapper">

        <section class="tf-auth-card">

            <!-- Header -->
            <div class="tf-auth-header text-center">

                <div class="tf-logo">
                    <i class="fa-solid fa-check-double"></i>
                </div>

                <h1 class="tf-brand">
                    Task<span>Flow</span>
                </h1>

                <h2>Welcome Back!</h2>

                <p>
                    Sign in to continue managing your tasks.
                </p>

            </div>

            <!-- Server Error -->
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger tf-server-error" role="alert">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span>@ViewBag.Error</span>
                </div>
            }

            <!-- Login Form -->
            <form asp-action="Login"
                  method="post"
                  id="loginForm"
                  novalidate>

                @Html.AntiForgeryToken()

                <!-- Email -->
                <div class="tf-form-group">

                    <label for="Email">
                        Email Address
                    </label>

                    <div class="tf-input-wrapper">

                        <i class="fa-regular fa-envelope input-icon"></i>

                        <input type="email"
                               id="Email"
                               name="Email"
                               class="form-control"
                               placeholder="name@example.com"
                               autocomplete="email"
                               required
                               autofocus />

                    </div>

                    <div class="tf-error" data-for="Email"></div>

                </div>

                <!-- Password -->
                <div class="tf-form-group">

                    <label for="Password">
                        Password
                    </label>

                    <div class="tf-input-wrapper">

                        <i class="fa-solid fa-lock input-icon"></i>

                        <input type="password"
                               id="Password"
                               name="Password"
                               class="form-control"
                               placeholder="Enter your password"
                               autocomplete="current-password"
                               required />

                        <button type="button"
                                class="tf-eye"
                                id="togglePassword"
                                aria-label="Show password">

                            <i class="fa-regular fa-eye"></i>

                        </button>

                    </div>

                    <div class="tf-error" data-for="Password"></div>

                </div>

                <!-- Remember / Forgot -->
                <div class="tf-form-options">

                    <label class="tf-remember">

                        <input type="checkbox"
                               id="rememberMe"
                               name="RememberMe"
                               value="true" />

                        <span class="tf-custom-checkbox">
                            <i class="fa-solid fa-check"></i>
                        </span>

                        <span>Remember me</span>

                    </label>

                    <a href="#" class="tf-forgot">
                        Forgot password?
                    </a>

                </div>

                <!-- Submit -->
                <button type="submit"
                        class="tf-submit-btn"
                        id="loginBtn">

                    <span class="btn-text">
                        Sign In
                        <i class="fa-solid fa-arrow-right"></i>
                    </span>

                    <span class="btn-loading d-none">
                        <span class="spinner-border spinner-border-sm"></span>
                        Signing in...
                    </span>

                </button>

            </form>

            <!-- Register -->
            <div class="tf-register">

                <span>Don't have an account?</span>

                <a href="/Account/Register">
                    Create an account
                </a>

            </div>

            <!-- Footer -->
            <div class="tf-auth-footer">
                <span>© 2026 TaskFlow. All rights reserved.</span>
            </div>

        </section>

    </main>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/Login.js" asp-append-version="true"></script>

</body>
</html>
