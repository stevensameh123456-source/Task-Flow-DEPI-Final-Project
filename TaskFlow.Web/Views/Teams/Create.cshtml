@model TaskFlow.Web.ViewModels.Teams.TeamFormVM
@{
    ViewData["Title"] = "New Team";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-4">New Team</h2>
        <form asp-action="Create" method="post">
            <input type="hidden" asp-for="WorkspaceId" />
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-controller="Workspaces" asp-action="Details" asp-route-id="@Model.WorkspaceId" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>