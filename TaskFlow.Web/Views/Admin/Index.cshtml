@{
    ViewData["Title"] = "Admin Dashboard - Workspaces & Projects";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-speedometer2"></i> Admin Control Panel</h2>
    </div>

    <!-- Quick Stats Summary -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-white bg-dark mb-3">
                <div class="card-body">
                    <h5 class="card-title">Total Projects</h5>
                    <p class="card-text display-6">12</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-secondary mb-3">
                <div class="card-body">
                    <h5 class="card-title">Active Boards</h5>
                    <p class="card-text display-6">24</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-info mb-3">
                <div class="card-body">
                    <h5 class="card-title">Custom Columns</h5>
                    <p class="card-text display-6">5</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Default Project Boards & Columns Setup -->
    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h5 class="mb-0">Default Board Columns Configuration</h5>
        </div>
        <div class="card-body">
            <p class="text-muted">Configure default status columns for new project boards:</p>
            <table class="table table-bordered table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Column Name</th>
                        <th>Default Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>1</td>
                        <td>To Do</td>
                        <td><span class="badge bg-secondary">Initial</span></td>
                        <td><button class="btn btn-sm btn-outline-primary">Edit</button></td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td>In Progress</td>
                        <td><span class="badge bg-warning text-dark">Active</span></td>
                        <td><button class="btn btn-sm btn-outline-primary">Edit</button></td>
                    </tr>
                    <tr>
                        <td>3</td>
                        <td>Done</td>
                        <td><span class="badge bg-success">Completed</span></td>
                        <td><button class="btn btn-sm btn-outline-primary">Edit</button></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>